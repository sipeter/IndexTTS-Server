<Window x:Class="IndexTtsDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IndexTTS Server"
        Icon="Assets/app.ico"
        Height="730" Width="1040"
        MinHeight="630" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgMain}"
        Closing="Window_Closing">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtAppTitle" Text="IndexTTS 服务端" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                        <Border Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1" CornerRadius="8" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtVersionBadge" Text="v0.1.0" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource AccentPrimary}" FontFamily="Consolas"/>
                        </Border>
                        <Border x:Name="StatusBadge" Background="#FEE2E2" CornerRadius="10" Padding="10,3" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="StatusText" Text="已停止" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentRed}"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="LblRootDir" Text="运行目录：" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="RootPathText" Text="" FontSize="12" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="460"/>
                        <Button x:Name="BtnBrowseRoot" Content="选择目录..." Style="{StaticResource SecondaryButton}" Padding="8,3" Margin="8,0,0,0" FontSize="12" Click="BrowseRoot_Click"/>
                        <Button x:Name="BtnRefreshHeader" Content="刷新" Style="{StaticResource SecondaryButton}" Padding="8,3" Margin="6,0,0,0" FontSize="12" Click="RefreshAll_Click"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnStart" Content="▶ 启动服务" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="StartServer_Click"/>
                    <Button x:Name="BtnStop" Content="■ 停止服务" Style="{StaticResource DangerButton}" Margin="0,0,8,0" IsEnabled="False" Click="StopServer_Click"/>
                    <Border Width="1" Height="22" Background="{StaticResource BorderSubtle}" Margin="6,0,12,0"/>
                    <ComboBox x:Name="CmbLanguage" Width="100" Height="30" VerticalContentAlignment="Center" Margin="0,0,8,0"
                              DisplayMemberPath="DisplayName" SelectedValuePath="Code" SelectionChanged="Language_SelectionChanged"/>
                    <Button x:Name="BtnHeaderGitHub" Style="{StaticResource IconButton}"
                            ToolTip="GitHub: https://github.com/sipeter/IndexTTS-Server"
                            Tag="https://github.com/sipeter/IndexTTS-Server" Click="OpenExternalLink_Click">
                        <Path Width="17" Height="17" Stretch="Uniform" Fill="#374151"
                              Data="M12,2A10,10 0 0,0 2,12C2,16.42 4.87,20.17 8.84,21.5C9.34,21.58 9.5,21.27 9.5,21C9.5,20.77 9.5,20.14 9.5,19.31C6.73,19.91 6.14,17.97 6.14,17.97C5.68,16.81 5.03,16.5 5.03,16.5C4.12,15.88 5.1,15.9 5.1,15.9C6.1,15.97 6.63,16.93 6.63,16.93C7.5,18.45 8.97,18 9.54,17.76C9.63,17.11 9.89,16.67 10.17,16.42C7.95,16.17 5.62,15.31 5.62,11.5C5.62,10.39 6,9.5 6.65,8.79C6.55,8.54 6.2,7.5 6.75,6.15C6.75,6.15 7.59,5.88 9.5,7.17C10.29,6.95 11.15,6.84 12,6.84C12.85,6.84 13.71,6.95 14.5,7.17C16.41,5.88 17.25,6.15 17.25,6.15C17.8,7.5 17.45,8.54 17.35,8.79C18,9.5 18.38,10.39 18.38,11.5C18.38,15.32 16.04,16.16 13.81,16.41C14.17,16.72 14.5,17.33 14.5,18.26C14.5,19.6 14.5,20.68 14.5,21C14.5,21.27 14.66,21.59 15.17,21.5C19.14,20.16 22,16.42 22,12A10,10 0 0,0 12,2Z"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Tabs -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <!-- Tab 1: Server & API -->
            <TabItem x:Name="TabServer" Header="  服务与 API 接入  " FontSize="13.5" Padding="12,6">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1.25*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Server Settings -->
                        <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock x:Name="LblServerSettings" Text="引擎与运行参数" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="115"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="34"/>
                                        <RowDefinition Height="34"/>
                                        <RowDefinition Height="34"/>
                                        <RowDefinition Height="30"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock x:Name="LblBackend" Grid.Row="0" Grid.Column="0" Text="推理后端：" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                                    <ComboBox x:Name="CmbBackend" Grid.Row="0" Grid.Column="1" Height="28" VerticalContentAlignment="Center" SelectionChanged="SettingsInput_Changed">
                                        <ComboBoxItem x:Name="CbiCuda" Content="CUDA 显卡加速（推荐）" Tag="cuda"/>
                                        <ComboBoxItem x:Name="CbiTrt" Content="TensorRT 加速（首次编译较慢）" Tag="tensorrt"/>
                                        <ComboBoxItem x:Name="CbiCpu" Content="CPU 兼容模式" Tag="cpu"/>
                                    </ComboBox>

                                    <TextBlock x:Name="LblPort" Grid.Row="1" Grid.Column="0" Text="监听端口：" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBox x:Name="TxtPort" Grid.Row="1" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Padding="6,0" Text="9966" LostFocus="SettingsInput_LostFocus"/>

                                    <TextBlock x:Name="LblAuthToken" Grid.Row="2" Grid.Column="0" Text="访问令牌：" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBox x:Name="TxtAuthToken" Grid.Row="2" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Padding="6,0" LostFocus="SettingsInput_LostFocus"/>

                                    <CheckBox x:Name="ChkMinimizeToTray" Grid.Row="3" Grid.ColumnSpan="2" Content="关闭窗口时最小化到系统托盘（服务继续在后台运行）"
                                              IsChecked="True" VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}" Click="SettingsInput_Changed"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- API & Model Info -->
                        <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock x:Name="LblApiTitle" Text="OpenAI 兼容 API 与原生接口接入" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblLanUrl" Grid.Column="0" Text="局域网地址：" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBox x:Name="TxtLanUrl" Grid.Column="1" IsReadOnly="True" Height="28" VerticalContentAlignment="Center" Padding="8,0" Background="#F9FAFB" FontFamily="Consolas"/>
                                    <Button x:Name="BtnCopyLanUrl" Grid.Column="2" Content="复制地址" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="8,0,0,0" Click="CopyLanUrl_Click"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblModelId" Grid.Column="0" Text="OpenAI 模型：" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBox Grid.Column="1" Text="indextts-1.5" IsReadOnly="True" Height="28" VerticalContentAlignment="Center" Padding="8,0" Background="#F9FAFB" FontFamily="Consolas"/>
                                    <Button x:Name="BtnCopyModelId" Grid.Column="2" Content="复制 ID" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="8,0,0,0" Click="CopyModelId_Click"/>
                                </Grid>

                                <DockPanel Margin="0,4,0,0">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button x:Name="BtnBrowseModels" Content="更换模型目录..." Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="12" Margin="6,0,0,0" Click="BrowseModelsDir_Click"/>
                                        <Button x:Name="BtnOpenModels" Content="打开" Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="12" Margin="6,0,0,0" Click="OpenModelsDir_Click"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtModelStatus" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondary}"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Quick Synthesis Test -->
                    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="165"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LblTestVoice" Grid.Column="0" Text="快捷试听  参考音色：" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CmbTestVoice" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="TxtTestInput" Grid.Column="2" Height="28" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,10,0"
                                     Text="你好，欢迎使用 IndexTTS 1.5 本地语音合成服务。"/>
                            <Button x:Name="BtnTestSpeak" Grid.Column="3" Content="🔊 合成试听" Style="{StaticResource PrimaryButton}" Padding="14,5" Click="TestSpeak_Click"/>
                        </Grid>
                    </Border>

                    <!-- Live Logs -->
                    <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock x:Name="LblLiveLogs" Text="实时服务日志" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                <Button x:Name="BtnClearLogs" DockPanel.Dock="Right" HorizontalAlignment="Right" Content="清空日志" Style="{StaticResource SecondaryButton}" Padding="10,3" FontSize="12" Click="ClearLogs_Click"/>
                            </DockPanel>
                            <TextBox x:Name="TxtLogs" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     Background="#111827" Foreground="#E5E7EB" BorderThickness="0" Padding="10"
                                     FontFamily="Consolas" FontSize="12"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 2: Models & Download -->
            <TabItem x:Name="TabModels" Header="  模型管理与下载  " FontSize="13.5" Padding="12,6">
                <Border Style="{StaticResource CardBorder}" Margin="0,10,0,0" Padding="22,20">
                    <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                        <DockPanel Margin="0,0,0,14">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="BtnBrowseModelsTab" Content="更换模型目录..." Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="BrowseModelsDir_Click"/>
                                <Button x:Name="BtnOpenModelsTab" Content="打开目录" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="OpenModelsDir_Click"/>
                                <Button x:Name="BtnRefreshModels" Content="刷新" Style="{StaticResource SecondaryButton}" Click="RefreshAll_Click"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="LblModelsHeading" Text="IndexTTS 1.5 模型包管理" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock x:Name="LblModelDirInfo" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- Single Clean Model Package Card -->
                        <Border Background="#FFFBF7" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="10" Padding="18">
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="BtnImportModelZip" Content="导入离线包 (.zip)" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="ImportModelZip_Click"/>
                                        <Button x:Name="BtnDownloadAllModels" Content="⬇ 一键下载并安装" Style="{StaticResource PrimaryButton}" Click="DownloadAllModels_Click"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="LblPkgTitle" Text="IndexTTS 1.5 轻量整合模型包 (INT4 + FP16)" FontSize="15.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                            <Border Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1" CornerRadius="8" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="~923 MB (.zip)" FontSize="11.5" FontFamily="Consolas" Foreground="{StaticResource AccentPrimary}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="LblPkgDesc" Text="单包自动下载并静默解压至 models 目录，用户无感。声码器 BigVGAN 与音色编码器保持 FP16 高保真，GPT 主干采用 INT4 轻量化，免填参考文本。"
                                                   FontSize="12.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,6,14,0"/>
                                    </StackPanel>
                                </DockPanel>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ProgressBar x:Name="PbModelDownload" Grid.Column="0" Minimum="0" Maximum="100" Height="9" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtModelDownloadStatus" Grid.Column="1" Margin="12,0,0,0" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                </Grid>

                                <TextBlock x:Name="LblModelSource" Margin="0,10,0,0" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Text=""/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- Tab 3: Reference Voices -->
            <TabItem x:Name="TabVoices" Header="  参考音色库 (refs)  " FontSize="13.5" Padding="12,6">
                <Border Style="{StaticResource CardBorder}" Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnImportVoice" Content="+ 导入参考音频 (.wav / .mp3)" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="ImportVoice_Click"/>
                                <Button x:Name="BtnBrowseRefsDir" Content="更换音色目录..." Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="BrowseRefsDir_Click"/>
                                <Button x:Name="BtnOpenRefsDir" Content="打开目录" Style="{StaticResource SecondaryButton}" Click="OpenRefsDir_Click"/>
                            </StackPanel>
                            <Button x:Name="BtnRefreshVoices" DockPanel.Dock="Right" HorizontalAlignment="Right" Content="刷新" Style="{StaticResource SecondaryButton}" Click="RefreshAll_Click"/>
                        </DockPanel>

                        <TextBlock x:Name="RefsHintText" Grid.Row="1" Margin="0,0,0,10" FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Text=""/>

                        <DataGrid x:Name="VoicesGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  RowHeight="40" AlternatingRowBackground="#F9FAFB" BorderBrush="{StaticResource BorderSubtle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn x:Name="ColVoiceName" Header="音色 ID" Binding="{Binding Name}" Width="200"/>
                                <DataGridTextColumn x:Name="ColVoiceFile" Header="文件名" Binding="{Binding FileName}" Width="*"/>
                                <DataGridTextColumn x:Name="ColVoiceFormat" Header="格式" Binding="{Binding Format}" Width="80"/>
                                <DataGridTextColumn x:Name="ColVoiceSize" Header="大小" Binding="{Binding SizeText}" Width="90"/>
                                <DataGridTemplateColumn x:Name="ColVoicePlay" Header="试听" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="▶" Tag="{Binding}" Style="{StaticResource SecondaryButton}" Padding="10,3" Margin="4" Click="PlayVoiceRef_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- Tab 3: About -->
            <TabItem x:Name="TabAbout" Header="  关于  " FontSize="13.5" Padding="12,6">
                <Border Style="{StaticResource CardBorder}" Margin="0,10,0,0" Padding="24,22">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="Assets/app_icon.png" Width="64" Height="64" Margin="0,2,18,0"
                                       VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="AboutTitle" Text="IndexTTS Server" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                        <Border Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1" CornerRadius="10" Padding="9,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="AboutVersionBadge" Text="v0.1.0" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentPrimary}" FontFamily="Consolas"/>
                                        </Border>
                                        <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="10" Padding="9,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Apache-2.0" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource AccentGreen}" FontFamily="Consolas"/>
                                        </Border>
                                        <Border Background="#F9FAFB" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="9,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="C++ ONNX Runtime" FontSize="11.5" Foreground="{StaticResource TextSecondary}" FontFamily="Consolas"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="AboutDesc" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource TextSecondary}" LineHeight="21" Margin="0,8,0,0" Text=""/>
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="AboutLinksHeader" Text="相关项目与资源" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10"/>
                            <UniformGrid Columns="2" Margin="0,0,0,18">
                                <Button Style="{StaticResource LinkCardButton}" Margin="0,0,10,10"
                                        Tag="https://github.com/sipeter/IndexTTS-Server" Click="OpenExternalLink_Click">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="↗" FontSize="15" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        <StackPanel>
                                            <TextBlock x:Name="LblCardSelf" Text="IndexTTS-Server 开源主页" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                            <TextBlock Text="github.com/sipeter/IndexTTS-Server" FontSize="11.5" Foreground="{StaticResource TextSecondary}" FontFamily="Consolas" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Button>

                                <Button Style="{StaticResource LinkCardButton}" Margin="0,0,0,10"
                                        Tag="https://github.com/index-tts/index-tts" Click="OpenExternalLink_Click">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="↗" FontSize="15" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        <StackPanel>
                                            <TextBlock x:Name="LblCardUpstream" Text="IndexTTS 上游官方仓库" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                            <TextBlock Text="github.com/index-tts/index-tts" FontSize="11.5" Foreground="{StaticResource TextSecondary}" FontFamily="Consolas" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Button>
                            </UniformGrid>

                            <Border Background="#F9FAFB" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="16,14">
                                <StackPanel>
                                    <TextBlock x:Name="AboutLicenseHeader" Text="开源致谢与许可说明" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="AboutLicenseBody" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource TextSecondary}" LineHeight="21" Text=""/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="AboutClientsLabel" Text="兼容 OpenAI TTS 生态客户端：Open WebUI、SillyTavern、开源阅读 (Legado) 及 " FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                        <TextBlock VerticalAlignment="Center">
                                            <Hyperlink NavigateUri="https://github.com/sipeter/CloneTTS" RequestNavigate="Hyperlink_RequestNavigate" Foreground="{StaticResource AccentPrimary}">CloneTTS ↗</Hyperlink>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
